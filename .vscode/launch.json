{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug DGTR ETTh1 96->96",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "--is_training",
        "1",
        "--root_path",
        "./dataset/",
        "--data_path",
        "ETTh1.csv",
        "--model_id",
        "ETTh1_96_96",
        "--model",
