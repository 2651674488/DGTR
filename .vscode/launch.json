        "24",
        "--train_epochs",
        "30",
        "--patience",
        "5",
        "--dropout",
        "0",
        "--individual",
        "0",
        "--itr",
        "1",
        "--batch_size",
        "256",
        "--learning_rate",
        "0.001",
        "--random_seed",
